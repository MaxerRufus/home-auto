# ==============================================================================
# SMART HOME HUB - WEB APPLICATION ENVIRONMENT VARIABLES
# Get these from your Supabase Dashboard: Project Settings -> API
# ==============================================================================

# 1. Supabase Project URL (e.g. https://abcdefghijklm.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# 2. Supabase Anon Key (Public Key)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# 3. Supabase Service Role Key (Secret Key - never exposed to browser)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
